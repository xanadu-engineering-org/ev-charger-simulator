<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>OCPP Simulator</title>
  <link rel="stylesheet" href="/public/styles.css">
</head>
<body>
  <%- include('layout') %>

  <main class="container">
    <section class="card">
      <div class="card-header">
        <h2>Connection</h2>
        <div class="status">
          <span class="dot <%= connected ? 'online' : 'offline' %>"></span>
          <span><%= connected ? 'WebSocket Connected' : 'Disconnected' %></span>
          <span class="dot <%= bootAccepted ? 'online' : 'offline' %>"></span>
          <span><%= bootAccepted ? 'Boot Accepted' : 'Awaiting BootNotification' %></span>
          <span>Heartbeat: <%= heartbeatInterval %>s</span>
        </div>
      </div>
      <form class="form-grid" action="/connect" method="POST">
        <label>
          OCPP Server URL
          <input type="text" name="ocppUrl" value="<%= ocppUrl %>" required>
        </label>
        <label>
          Charge Point ID
          <input type="text" name="chargePointId" value="<%= chargePointId %>" required>
        </label>
        <label>
          Vendor
          <input type="text" name="chargePointVendor" value="<%= chargePointVendor %>" required>
        </label>
        <label>
          Model
          <input type="text" name="chargePointModel" value="<%= chargePointModel %>" required>
        </label>
        <% if (!connected) { %>
          <button type="submit" class="primary">Connect</button>
        <% } %>
      </form>
      <% if (connected) { %>
        <div class="actions">
          <form action="/disconnect" method="POST">
            <button type="submit" class="danger">Disconnect</button>
          </form>
          <form action="/reconnect" method="POST">
            <button type="submit" class="primary">Reconnect</button>
          </form>
        </div>
      <% } %>
    </section>
    <% if (errorMessage) { %>
      <div class="modal-overlay show" id="error-modal">
        <div class="modal">
          <h3>Error</h3>
          <p><%= errorMessage %></p>
          <button class="primary" id="close-modal">Close</button>
        </div>
      </div>
      <script>
        (function () {
          const overlay = document.getElementById('error-modal');
          const closeBtn = document.getElementById('close-modal');
          function closeModal() {
            overlay.classList.remove('show');
            const url = new URL(window.location.href);
            url.searchParams.delete('error');
            window.history.replaceState({}, '', url.toString());
          }
          closeBtn.addEventListener('click', function (e) {
            e.preventDefault();
            closeModal();
          });
        })();
      </script>
    <% } %>

    <section>
      <h2>Connectors</h2>
      <div class="connector-grid">
        <% connectors.forEach(function(conn) { %>
          <div class="card connector-card" id="connector-card-<%= conn.id %>">
            <div class="card-header">
              <div>
                <strong>Connector <%= conn.id %></strong>
                <span class="state badge" id="state-badge-<%= conn.id %>"><%= conn.state %></span>
                <span class="plug-status badge <%= conn.pluggedIn ? 'plugged' : 'unplugged' %>" id="plug-badge-<%= conn.id %>">
                  <%= conn.pluggedIn ? '🔌 Plugged In' : '🔌 Not Plugged' %>
                </span>
              </div>
              <div>Meter: <span id="meter-<%= conn.id %>"><%= conn.meterWh %></span> Wh</div>
            </div>
            <div class="connector-body">
              <form action="/actions/<%= conn.id %>/presentToken" method="POST">
                <label>Id Tag
                  <input type="text" name="idTag" value="<%= conn.idTag %>" placeholder="RFID / tag" required>
                </label>
                <div class="actions">
                  <button type="submit">Present Token</button>
                  <button type="submit" formaction="/actions/<%= conn.id %>/startCharging" class="primary" id="startBtn-<%= conn.id %>" <%= !conn.pluggedIn ? 'disabled title="EV must be plugged in to start charging"' : '' %>>Local Start</button>
                </div>
              </form>

              <div class="actions">
                <form action="/actions/<%= conn.id %>/plugIn" method="POST">
                  <button type="submit">Plug In EV</button>
                </form>
                <form action="/actions/<%= conn.id %>/unplug" method="POST">
                  <button type="submit">Unplug EV</button>
                </form>
              </div>

              <div class="actions">
                <form action="/actions/<%= conn.id %>/stopCharging" method="POST">
                  <button type="submit" class="danger">Local Stop</button>
                </form>
              </div>

              <dl class="meta">
                <div><dt>Plugged:</dt><dd id="plugged-status-<%= conn.id %>"><%= conn.pluggedIn ? 'Yes' : 'No' %></dd></div>
                <div><dt>Transaction:</dt><dd id="transaction-<%= conn.id %>"><%= conn.transactionId || '-' %></dd></div>
              </dl>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
  </main>
  <style>
    .plug-status.badge {
      margin-left: 10px;
      padding: 4px 8px;
      border-radius: 4px;
      font-size: 0.9em;
    }
    .plug-status.plugged {
      background-color: #4caf50;
      color: white;
    }
    .plug-status.unplugged {
      background-color: #9e9e9e;
      color: white;
    }
    button:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }
  </style>
  <script>
    // Auto-refresh connector status every 2 seconds and update button states and display
    setInterval(() => {
      fetch('/api/connectors')
        .then(res => res.json())
        .then(data => {
          if (data.connectors) {
            data.connectors.forEach(conn => {
              // Update state badge
              const stateBadge = document.getElementById('state-badge-' + conn.id);
              if (stateBadge) {
                const stateValue = String(conn.state || 'Unknown').trim();
                stateBadge.textContent = stateValue;
                // Update badge class based on state
                stateBadge.className = 'state badge';
                // Reset styles first
                stateBadge.style.backgroundColor = '';
                stateBadge.style.color = '';
                if (stateValue === 'Charging') {
                  stateBadge.style.backgroundColor = '#ff9800';
                  stateBadge.style.color = 'white';
                } else if (stateValue === 'Available') {
                  stateBadge.style.backgroundColor = '#4caf50';
                  stateBadge.style.color = 'white';
                } else if (stateValue === 'Preparing') {
                  stateBadge.style.backgroundColor = '#2196f3';
                  stateBadge.style.color = 'white';
                }
              }
              
              // Update plug status badge
              const plugBadge = document.getElementById('plug-badge-' + conn.id);
              if (plugBadge) {
                plugBadge.textContent = conn.pluggedIn ? '🔌 Plugged In' : '🔌 Not Plugged';
                plugBadge.className = 'plug-status badge ' + (conn.pluggedIn ? 'plugged' : 'unplugged');
              }
              
              // Update plugged status text
              const pluggedStatus = document.getElementById('plugged-status-' + conn.id);
              if (pluggedStatus) {
                pluggedStatus.textContent = conn.pluggedIn ? 'Yes' : 'No';
              }
              
              // Update transaction ID
              const transactionEl = document.getElementById('transaction-' + conn.id);
              if (transactionEl) {
                transactionEl.textContent = conn.transactionId || '-';
              }
              
              // Update meter value
              const meterEl = document.getElementById('meter-' + conn.id);
              if (meterEl) {
                meterEl.textContent = conn.meterWh;
              }
              
              // Update start button state
              const startBtn = document.getElementById('startBtn-' + conn.id);
              if (startBtn) {
                if (conn.pluggedIn) {
                  startBtn.disabled = false;
                  startBtn.removeAttribute('title');
                } else {
                  startBtn.disabled = true;
                  startBtn.setAttribute('title', 'EV must be plugged in to start charging');
                }
              }
            });
          }
        })
        .catch(err => console.error('Error fetching connector status:', err));
    }, 2000);
    
    // Also update immediately on page load
    window.addEventListener('DOMContentLoaded', () => {
      fetch('/api/connectors')
        .then(res => res.json())
        .then(data => {
          if (data.connectors) {
            data.connectors.forEach(conn => {
              // Update all display elements (same logic as interval)
              const stateBadge = document.getElementById('state-badge-' + conn.id);
              if (stateBadge) {
                stateBadge.textContent = conn.state;
                stateBadge.className = 'state badge';
                if (conn.state === 'Charging') {
                  stateBadge.style.backgroundColor = '#ff9800';
                  stateBadge.style.color = 'white';
                } else if (conn.state === 'Available') {
                  stateBadge.style.backgroundColor = '#4caf50';
                  stateBadge.style.color = 'white';
                } else if (conn.state === 'Preparing') {
                  stateBadge.style.backgroundColor = '#2196f3';
                  stateBadge.style.color = 'white';
                }
              }
              
              const plugBadge = document.getElementById('plug-badge-' + conn.id);
              if (plugBadge) {
                plugBadge.textContent = conn.pluggedIn ? '🔌 Plugged In' : '🔌 Not Plugged';
                plugBadge.className = 'plug-status badge ' + (conn.pluggedIn ? 'plugged' : 'unplugged');
              }
              
              const pluggedStatus = document.getElementById('plugged-status-' + conn.id);
              if (pluggedStatus) {
                pluggedStatus.textContent = conn.pluggedIn ? 'Yes' : 'No';
              }
              
              const transactionEl = document.getElementById('transaction-' + conn.id);
              if (transactionEl) {
                transactionEl.textContent = conn.transactionId || '-';
              }
              
              const meterEl = document.getElementById('meter-' + conn.id);
              if (meterEl) {
                meterEl.textContent = conn.meterWh;
              }
              
              const startBtn = document.getElementById('startBtn-' + conn.id);
              if (startBtn && conn.pluggedIn) {
                startBtn.disabled = false;
                startBtn.removeAttribute('title');
              }
            });
          }
        })
        .catch(err => console.error('Error fetching connector status:', err));
    });
  </script>
</body>
</html>
